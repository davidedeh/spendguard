# Copy to .env for local runs. Tests never read this file's copy; they use tests/settings_factory.py.
# An empty value means "not configured".

APP_ENVIRONMENT=local
LOG_LEVEL=INFO

# Local compose Postgres. The database name derives from the branch.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=spendguard
POSTGRES_PASSWORD=spendguard
# Deployed only: the Supabase transaction pooler URL. Overrides the branch database when set.
DATABASE_URL=

AWS_REGION=us-east-1
# Local ElasticMQ. Leave empty when deployed.
SQS_ENDPOINT_URL=http://localhost:9324
# Deployed only. Locally the queue name derives from the branch.
QUEUE_URL=
# Deployed only: where SecureString parameters live.
SSM_PARAMETER_PREFIX=

# The deployed environment allows bedrock only.
ALLOWED_PROVIDERS=["bedrock","google_genai"]
CHAT_MODELS__CLAUDE_HAIKU__PROVIDER=bedrock
CHAT_MODELS__CLAUDE_HAIKU__MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
CHAT_MODELS__CLAUDE_HAIKU__STRUCTURED_OUTPUT_METHOD=function_calling
CHAT_MODELS__CLAUDE_HAIKU__TEMPERATURE=0
CHAT_MODELS__CLAUDE_SONNET__PROVIDER=bedrock
CHAT_MODELS__CLAUDE_SONNET__MODEL_ID=us.anthropic.claude-sonnet-4-6
CHAT_MODELS__CLAUDE_SONNET__STRUCTURED_OUTPUT_METHOD=function_calling
CHAT_MODELS__CLAUDE_SONNET__TEMPERATURE=0
CHAT_MODELS__GPT_OSS__PROVIDER=bedrock
CHAT_MODELS__GPT_OSS__MODEL_ID=openai.gpt-oss-120b-1:0
CHAT_MODELS__GPT_OSS__STRUCTURED_OUTPUT_METHOD=json_schema
CHAT_MODELS__GPT_OSS__TEMPERATURE=0
CHAT_MODELS__NOVA_PRO__PROVIDER=bedrock
CHAT_MODELS__NOVA_PRO__MODEL_ID=us.amazon.nova-pro-v1:0
CHAT_MODELS__NOVA_PRO__STRUCTURED_OUTPUT_METHOD=function_calling
CHAT_MODELS__NOVA_PRO__TEMPERATURE=0
CHAT_MODELS__GEMINI_PRO__PROVIDER=google_genai
CHAT_MODELS__GEMINI_PRO__MODEL_ID=gemini-3.1-pro-preview
CHAT_MODELS__GEMINI_PRO__STRUCTURED_OUTPUT_METHOD=json_schema
CHAT_MODELS__GEMINI_PRO__TEMPERATURE=0
PRIMARY_MODEL_KEY=claude_haiku
# The most capable configured model per provider.
DRAFTING_MODEL_KEYS=["claude_sonnet","gpt_oss","nova_pro"]
EMBEDDING_MODEL__PROVIDER=bedrock
EMBEDDING_MODEL__MODEL_ID=amazon.titan-embed-text-v2:0
# Per chat model key, for eval cost: {"claude_haiku": {"input_per_million_tokens_usd": "...",
# "output_per_million_tokens_usd": "...", "priced_on": "YYYY-MM-DD"}}. Empty until prices are set.
MODEL_PRICES={}
# Per chat model key, the eval's Bedrock requests per minute, kept under the account's
# requests-per-minute quota for that model: {"claude_haiku": 8}. Empty until rates are set.
EVAL_REQUESTS_PER_MINUTE={}
# The eval's model rows, in report order: a configured chat model key, the label the results table shows, and the policy context (retrieved_clauses, or whole_policy to skip retrieval).
EVAL_ROWS=[{"model_key":"claude_haiku","label":"Claude Haiku (primary)","policy_context":"retrieved_clauses"},{"model_key":"claude_sonnet","label":"Claude Sonnet","policy_context":"retrieved_clauses"},{"model_key":"gpt_oss","label":"GPT OSS 120B (OpenAI's open-weight model)","policy_context":"retrieved_clauses"},{"model_key":"nova_pro","label":"Nova Pro (AWS-native)","policy_context":"retrieved_clauses"},{"model_key":"gemini_pro","label":"Gemini Pro (Google GenAI API)","policy_context":"retrieved_clauses"},{"model_key":"claude_haiku","label":"Claude Haiku, whole policy (no retrieval)","policy_context":"whole_policy"}]
# Eval only.
GOOGLE_API_KEY=

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

WEBHOOK_SIGNING_KEY=
DECISION_EVENT_SIGNING_KEY=
DECISION_EVENT_URL=http://localhost:8000/mock-erp/decision-events
SIGNATURE_TOLERANCE_SECONDS=300

FORCE_HUMAN_REVIEW=false
# Characters kept per submission text field; intake cuts anything longer.
MAXIMUM_FIELD_LENGTH=2000
JUDGEMENT_MAX_TOOL_CALLS=6
RETRIEVAL_TOP_K=5
WORKER_TIMEOUT_SECONDS=120
# At least six times WORKER_TIMEOUT_SECONDS.
QUEUE_VISIBILITY_TIMEOUT_SECONDS=720
# Longer than QUEUE_VISIBILITY_TIMEOUT_SECONDS.
SWEEPER_STUCK_AFTER_SECONDS=900
